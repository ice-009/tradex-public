// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  brokerAccessToken    String?
  brokerRefreshToken   String?
  brokerTokenExpiresAt DateTime?
  cashLiveModeEnabled  Boolean   @default(true)
  fnoLiveModeEnabled   Boolean   @default(true)
  accounts             Account[]
  sessions             Session[]
  subscription         Subscription?
  portfolioPositions   PortfolioPosition[]
  trades               Trade[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String   @unique
  status        String   // active, inactive, cancelled
  plan          String   // basic, premium
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  razorpaySubscriptionId String? @unique
  razorpayCustomerId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioPosition {
  id           String   @id @default(cuid())
  userId       String
  symbol       String
  name         String
  sector       String
  quantity     Int
  avgBuyPrice  Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
}

// A trade taken from the daily plan (the journal). Long only for now; `side`
// is stored so short strategies can be added later. The plan's levels are
// copied in when the trade is taken, so the journal can compare your fills
// with the plan and track the exit rule even if the screen changes later.
model Trade {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  screenId     String
  side         String    @default("long")
  plannedEntry Float
  stop         Float
  target       Float?
  // "next-open", "stop-target", "time" or "trail-low:10" (src/core/plan/instructions.ts)
  exitRule     String
  holdSessions Int
  entryPrice   Float
  entryAt      DateTime
  lots         Int
  lotSize      Int
  quantity     Int
  // "open" or "closed"
  status       String    @default("open")
  exitPrice    Float?
  exitAt       DateTime?
  // "open", "stop", "target", "trail", "time" or "manual"
  exitReason   String?
  plannedExit  Float?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
