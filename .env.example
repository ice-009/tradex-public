# Copy to .env (or .env.local) and fill in. Never commit the real file.

# ------------------------------------------------------------------ required

# Sign-in sessions (NextAuth). Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Local SQLite database (created by `npm run db:setup`).
DATABASE_URL=file:./dev.db

# ------------------------------------------------------------------ Market Data Hub (required for real data)
# Tradex gets ALL its market data from a Market Data Hub
# (https://github.com/ice-009/market-data-hub): charts, quotes, live prices, the
# screener's and backtests' daily bars, open interest, the F&O list, lot sizes,
# the ban list and results dates. It makes no broker or NSE requests itself.
# Without these two settings it runs on clearly labelled sample data and shows
# "Connect a Market Data Hub".
#
# Create a key on the hub (read-only scopes are enough; Tradex never needs admin):
#   npm run hub -- keys create tradex --scopes history,live,fo

# The hub's address, e.g. http://127.0.0.1:8787 or https://hub.example.com
HUB_URL=
# The API key (mdh_…). Sent only as an Authorization header; never logged.
HUB_KEY=
# Per-request timeout in ms (default 30000).
# HUB_TIMEOUT_MS=30000

# ------------------------------------------------------------------ optional

# Where the local candle cache lives (default .cache/market.db).
# MARKET_DB_PATH=
