# Copy to .env (or .env.local) and fill in. Never commit the real file.

# ------------------------------------------------------------------ required

# Sign-in sessions (NextAuth). Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Local SQLite database (created by `npm run db:setup`).
DATABASE_URL=file:./dev.db

# ------------------------------------------------------------------ Market Data Hub (required for real data)
# Tradex gets ALL its market data from a Market Data Hub
# (https://github.com/ice-009/market-data-hub): charts, quotes, live prices, the
# screener's and backtests' daily bars, open interest, the F&O list, lot sizes,
# the ban list and results dates. It makes no broker or NSE requests itself.
# Without these two settings it runs on clearly labelled sample data and shows
# "Connect a Market Data Hub".
#
# Create a key on the hub (read-only scopes are enough; Tradex never needs admin):
#   npm run hub -- keys create tradex --scopes history,live,fo

# The hub's address, e.g. http://127.0.0.1:8787 or https://hub.example.com
HUB_URL=
# The API key (mdh_…). Sent only as an Authorization header; never logged.
HUB_KEY=
# Per-request timeout in ms (default 30000).
# HUB_TIMEOUT_MS=30000

# ------------------------------------------------------------------ optional

# Where the local candle cache lives (default .cache/market.db).
# MARKET_DB_PATH=

# Server log: JSON lines on stdout/stderr, one per event, with a request id on
# every line written while an API request is handled. debug | info | warn | error
# (default info; debug also logs every successful API request).
# LOG_LEVEL=info

# Prometheus metrics at /api/metrics need a signed-in session, or this token as
# `Authorization: Bearer <token>` (for a scraper). Unset: session only.
# Generate one with:  openssl rand -hex 24
# METRICS_TOKEN=

# ------------------------------------------------------------------ Docker Compose (`docker compose up -d`)
# compose.yaml runs Tradex together with its own Market Data Hub. Nothing here
# is required: Tradex's hub key is created on first start, and so is
# NEXTAUTH_SECRET when it's empty; both are kept in the stack's volumes. The
# stack wires its own HUB_URL, HUB_KEY and DATABASE_URL (the values above are
# for `npm run dev` and are ignored there). NEXTAUTH_SECRET is shared.

# Host port and address Tradex is published on (default 127.0.0.1:3000;
# TRADEX_BIND=0.0.0.0 opens it to your network).
# TRADEX_PORT=3000
# TRADEX_BIND=127.0.0.1
# The address you open Tradex at, if not http://localhost:$TRADEX_PORT.
# TRADEX_URL=
# market-data-hub branch, tag or commit to build (default main).
# HUB_REF=main
# Release to run with compose.release.yaml (default latest), e.g. 0.2.0.
# TRADEX_VERSION=

# The hub's broker login, for real prices and history (Fyers API v3, data only;
# see github.com/ice-009/market-data-hub). These go to the hub container only;
# Tradex never sees them. Without them the hub serves what it has stored plus
# NSE's daily files.
# FYERS_CLIENT_ID=
# FYERS_SECRET_KEY=
# FYERS_FY_ID=
# FYERS_PIN=
# FYERS_TOTP_SECRET=
# FYERS_PLAN=standard
# FYERS_REDIRECT_URL=
# Hub tuning (defaults shown).
# HUB_LIVE=on
# HUB_LIVE_SYMBOLS=NIFTY,BANKNIFTY
# HUB_JOBS=on
# HUB_LOG_LEVEL=info
