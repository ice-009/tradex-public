# Copy to .env (or .env.local) and fill in. Never commit the real file.

# ------------------------------------------------------------------ required

# Sign-in sessions (NextAuth). Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Local SQLite database (created by `npm run db:setup`).
DATABASE_URL=file:./dev.db

# ------------------------------------------------------------------ Fyers (optional)
# Without these, Tradex still runs: daily charts and the screener use the NSE
# end-of-day store once it has history, intraday charts use labelled sample data,
# and live prices are off. With them, a server-side TOTP login gives live data.
# Create an app at https://myapi.fyers.in/dashboard (redirect URL below).

# App ID, e.g. ABCD1234EF-100
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
# Your Fyers login (client ID), 4-digit PIN and the TOTP secret from
# enabling external 2FA TOTP in your Fyers account (the base32 key, not a 6-digit code).
FYERS_FY_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=
FYERS_REDIRECT_URL=http://localhost:3000/api/broker/callback

# "standard" (5 calls/s, 50/min, 5,000/day, 100 live symbols) or "prime".
# Tradex paces every API call to stay inside these limits.
FYERS_PLAN=standard

# ------------------------------------------------------------------ data engine (optional)
# Order in which market-data sources are tried (comma-separated ids).
# Available: fyers, eod, sample. Example without a broker: DATA_SOURCES=eod,sample
DATA_SOURCES=fyers,eod,sample

# Advanced: override Fyers endpoints (testing against a mock server).
# FYERS_API_URL=https://api-t1.fyers.in/api/v3
# FYERS_DATA_URL=https://api-t1.fyers.in/data
